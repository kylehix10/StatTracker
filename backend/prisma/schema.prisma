// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id          Int @id @default(autoincrement())
  firstName   String
  lastName    String
  email       String @unique
  password    String 
  Team        Team[]
}

model Sport {
  id        String  @id @default(cuid())
  name      String  @unique // e.g. Basketball, Soccer
  teams     Team[]
}

model Team{
  id          String   @id @default(cuid())
  name        String
  town        String
  type        String
  sport       Sport
  sportId     String
  year        Int
  roster      Athlete[]
}

model Athlete{
  id         String   @id @default(cuid())
  firstName  String
  lastName   String
  dateOfBirth DateTime?
  teamHistory AthleteTeam[]
  gameStats   AthleteGameStat[]

}

model Season {
  id        String   @id @default(cuid())
  name      String   
  startDate DateTime
  endDate   DateTime
  games     Game[]
}

model Game {
  id        String   @id @default(cuid())
  date      DateTime
  seasonId  String
  season    Season   @relation(fields: [seasonId], references: [id])
  homeTeamId String
  awayTeamId String
  homeTeam  Team @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam  Team @relation("AwayTeam", fields: [awayTeamId], references: [id])
  athleteStats AthleteGameStat[]
}

model AthleteTeam {
  id         String   @id @default(cuid())
  athleteId  String
  teamId     String
  startDate  DateTime
  endDate    DateTime?

  athlete    Athlete  @relation(fields: [athleteId], references: [id])
  team       Team     @relation(fields: [teamId], references: [id])

  @@index([athleteId])
  @@index([teamId])
}

model AthleteGameStat {
  id         String  @id @default(cuid())

  athleteId  String
  gameId     String

  athlete    Athlete @relation(fields: [athleteId], references: [id])
  game       Game    @relation(fields: [gameId], references: [id])

  // Common stats (extend as needed per sport)
  minutesPlayed Int?

  points     Int?    // basketball
  assists    Int?
  rebounds   Int?

  goals      Int?    // soccer/hockey
  shots      Int?

  hits       Int?    // baseball
  homeRuns   Int?
}